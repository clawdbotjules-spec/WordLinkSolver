<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>WordLinkSolver.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The platform-agnostic core is compiled in directly (linked sources), so
       the solver/detector logic is testable on any OS without the WinForms
       app's Windows-only target framework. -->
  <ItemGroup>
    <Compile Include="..\Core\TrieSolver.cs" Link="Linked\TrieSolver.cs" />
    <Compile Include="..\Core\Scorer.cs" Link="Linked\Scorer.cs" />
    <Compile Include="..\Core\SolveSession.cs" Link="Linked\SolveSession.cs" />
    <Compile Include="..\Core\OcrNormalizer.cs" Link="Linked\OcrNormalizer.cs" />
    <Compile Include="..\Core\GridDetector.cs" Link="Linked\GridDetector.cs" />
    <Compile Include="..\Models\WordResult.cs" Link="Linked\WordResult.cs" />
    <Compile Include="..\Models\LetterTile.cs" Link="Linked\LetterTile.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Resources\sowpods.txt" Link="Resources\sowpods.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
